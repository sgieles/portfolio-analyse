# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Local price cache (re-downloaded from Yahoo Finance)
cache/
.cache/
.research_cache/

# research/cache/ is Python source — explicitly un-ignore so the cache/ rule above
# doesn't swallow it.  The *.json data files inside are ignored by the *.json rule.
!research/cache/
!research/cache/*.py

# Exported reports (user-generated, not source code)
*.pdf
*.xlsx
*.csv

# Saved portfolios (personal data)
*.json

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Logs
*.log
